# StreamZH systemd service. The .deb and .rpm packages install this file as /usr/lib/systemd/system/streamzh.service;
# tools/install-linux.sh writes the same to /etc/systemd/system/streamzh.service with the folders and user of its
# options. By hand:
#   sudo useradd --system --user-group --home-dir /var/lib/streamzh --shell /usr/sbin/nologin streamzh
#   sudo install -d -o streamzh -g streamzh -m 0750 /var/lib/streamzh
#   sudo cp -R <unpacked package>/. /opt/streamzh/ && sudo chmod 0755 /opt/streamzh/StreamZH
#   sudo cp docs/streamzh.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now streamzh
[Unit]
Description=StreamZH - one app for your whole media pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=streamzh
Group=streamzh
Environment=STREAMZH_DATA=/var/lib/streamzh
WorkingDirectory=/opt/streamzh
ExecStart=/opt/streamzh/StreamZH
# Restart after a crash; "Shutdown" in the web UI stops it for good.
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
# New files: group may read and write (media folders shared with Plex/Jellyfin).
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Hardening: StreamZH needs no devices, kernel settings, namespaces or extra privileges.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
