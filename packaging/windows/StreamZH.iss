; StreamZH - one app for your whole media pipeline.
; Copyright (c) 2026 The StreamZH Authors.
; SPDX-License-Identifier: GPL-3.0-only
;
; Windows installer (Inno Setup 6.7): StreamZH-<version>-win-x64-setup.exe. See docs/PACKAGING.md.
;
;   iscc /DSourceDir=<published win-x64 folder> /DOutputDir=<dist> packaging\windows\StreamZH.iss
;
; SourceDir holds StreamZH.exe, StreamZH.Tray.exe (self-contained, no .NET runtime needed) and wwwroot. The version
; comes from <Version> in Directory.Build.props unless /DAppVersion=... is given. The wizard images are generated by
; packaging\windows\generate-wizard-images.py (committed in packaging\windows\images).
;
; The wizard: Welcome -> "How should StreamZH run?" (service or tray only, plus options) -> "Where are your movies and
; series?" (service only) -> Ready -> Installing -> Finish ("Start StreamZH", "Open StreamZH in my browser"). An upgrade
; shows Welcome -> Ready -> Finish with the remembered choices (a box on the Welcome page shows the choice pages again).
; No license page (the GPL needs no acceptance; LICENSE is installed and linked on the Welcome page) and no folder
; page (only with /ALLOWCUSTOMDIR).
;
; What the setup does:
; - installs per machine to C:\Program Files\StreamZH (only administrators may change it, as StreamZH's program
;   folder check expects); data stays in C:\ProgramData\StreamZH and survives upgrades and uninstalling;
; - runs the bundled PowerShell scripts for the service work (one implementation with the manual install):
;   tools\Install-Service.ps1 (Windows service, the default) or tools\Install-Tray.ps1 (tray icon only), with
;   -Firewall, -AllowControlledFolderAccess, -FoldersFile and -NoStart; "Start StreamZH" on the Finish page then starts
;   the service and the tray icon (or the tray icon with --start); silent installs start it too;
; - upgrades in place: stops StreamZH and its tray icons, replaces the program, runs the script again with the same
;   choices and starts StreamZH again;
; - moves an older manual installation (service from C:\Tools\StreamZH) over to the new program folder;
; - uninstall: one question (remove StreamZH, optionally also the data), tools\Uninstall-Service.ps1, then removes the
;   program; the data only when "Also delete my data" is ticked or /DELETEDATA=1 is given.
;
; Silent installs: setup.exe /VERYSILENT /TASKS="service,firewall" /FOLDERS="D:\Media;D:\Downloads"
; Silent uninstall that also deletes the data: unins000.exe /VERYSILENT /DELETEDATA=1
;
; Security (review SV4):
; - the program folder must be inside Program Files, where only administrators may change files, because the setup runs
;   scripts from it as administrator and the service runs StreamZH.exe from it. Another folder needs /ALLOWCUSTOMDIR;
;   the setup then makes it administrators-only (owner and access list) BEFORE it copies anything, and refuses a link
;   or a folder that already holds files (X-06);
; - folder names never become PowerShell code: the folders go to Install-Service.ps1 in a file (-FoldersFile), and the
;   paths that are still quoted double every kind of single quote (X-04);
; - "tray only" is refused when the setup runs as SYSTEM (Intune, SCCM, RMM tools), because StreamZH would run as SYSTEM;
;   an upgrade of a tray-only installation then only replaces the files (X-05). The tray icon is never started as SYSTEM;
; - "Also delete my data" uses DelTree, which deletes junctions and symbolic links inside the data folder without
;   following them (Inno Setup's DelTree skips the contents of reparse points; checked in the 6.7.0 source) (X-11).

#ifndef SourceDir
  #error Pass the published win-x64 folder: iscc /DSourceDir=...
#endif
#ifndef OutputDir
  #define OutputDir "..\..\dist"
#endif
; "modern dynamic" follows Windows' light or dark mode; /DWizardLook="modern dark" forces dark (screenshots).
#ifndef WizardLook
  #define WizardLook "modern dynamic"
#endif
#define RepoDir AddBackslash(SourcePath) + "..\.."

#ifndef AppVersion
  ; <Version>1.2.3</Version> from Directory.Build.props.
  #define PropsHandle FileOpen(RepoDir + "\Directory.Build.props")
  #if !PropsHandle
    #error Directory.Build.props not found
  #endif
  #define VersionLine ""
  #sub ReadPropsLine
    #define PropsLine Trim(FileRead(PropsHandle))
    #define public VersionLine Pos("<Version>", PropsLine) == 1 ? PropsLine : VersionLine
  #endsub
  #for {0; !FileEof(PropsHandle); 0} ReadPropsLine
  #expr FileClose(PropsHandle)
  #if VersionLine == ""
    #error No <Version> in Directory.Build.props
  #endif
  #define AppVersion Copy(VersionLine, 10, Pos("</Version>", VersionLine) - 10)
#endif

; 1.0.0-rc.1 -> 1.0.0 for the numeric file version.
#if Pos("-", AppVersion) > 0
  #define NumericVersion Copy(AppVersion, 1, Pos("-", AppVersion) - 1)
#else
  #define NumericVersion AppVersion
#endif

#define AppUrl "https://github.com/streamzh/streamzh"
#define WebUi "http://localhost:9797"
#define Publisher "StreamZH (a CloudZH product)"
#define Copyright "Copyright (c) 2026 The StreamZH Authors"
#define Images AddBackslash(SourcePath) + "images\"

[Setup]
; Never change the AppId: upgrades find the installed copy by it.
AppId={{80733154-B4A9-4387-94A6-31794276A4B5}
AppName=StreamZH
AppVersion={#AppVersion}
AppVerName=StreamZH {#AppVersion}
AppPublisher={#Publisher}
AppPublisherURL={#AppUrl}
AppSupportURL={#AppUrl}
AppUpdatesURL={#AppUrl}
AppComments=One app for your whole media pipeline
AppCopyright={#Copyright}
VersionInfoVersion={#NumericVersion}
VersionInfoProductVersion={#NumericVersion}
VersionInfoProductTextVersion={#AppVersion}
VersionInfoTextVersion={#AppVersion}
VersionInfoProductName=StreamZH
VersionInfoCompany={#Publisher}
VersionInfoCopyright={#Copyright}
VersionInfoDescription=StreamZH Setup
DefaultDirName={autopf}\StreamZH
; Shown only with /ALLOWCUSTOMDIR (ShouldSkipPage).
DisableDirPage=no
DisableProgramGroupPage=yes
; Only for removing the Start menu folder of 1.0.0-rc.1; the shortcuts are directly in the Start menu now.
DefaultGroupName=StreamZH
DisableWelcomePage=no
DisableReadyPage=no
UsePreviousAppDir=yes
UsePreviousTasks=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
SetupIconFile={#RepoDir}\src\StreamZH.Tray\streamzh.ico
UninstallDisplayIcon={app}\streamzh.ico
UninstallDisplayName=StreamZH
OutputDir={#OutputDir}
OutputBaseFilename=StreamZH-{#AppVersion}-win-x64-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle={#WizardLook}
WizardSizePercent=120
WizardImageFile={#Images}wizard-202x386.png,{#Images}wizard-269x515.png,{#Images}wizard-336x643.png,{#Images}wizard-403x772.png,{#Images}wizard-430x824.png,{#Images}wizard-498x953.png,{#Images}wizard-534x1022.png
WizardSmallImageFile={#Images}wizard-small-58.png,{#Images}wizard-small-77.png,{#Images}wizard-small-97.png,{#Images}wizard-small-116.png,{#Images}wizard-small-124.png,{#Images}wizard-small-143.png,{#Images}wizard-small-159.png
; StreamZH, its tray icon and the service are stopped in PrepareToInstall; no Restart Manager.
CloseApplications=no
RestartApplications=no
SetupLogging=yes
ChangesAssociations=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
SetupWindowTitle=%1 Setup
WelcomeLabel1=Welcome to StreamZH
WelcomeLabel2=StreamZH brings your movies and series, your indexers and your downloads together in one app.%n%nSetup takes about a minute.
WizardReady=Ready to install
ReadyLabel1=Setup is ready to install StreamZH.
ReadyLabel2a=Click Install to continue.
WizardInstalling=Installing
InstallingLabel=Please wait while StreamZH is installed. This takes a moment.
FinishedHeadingLabel=StreamZH is ready
UninstallAppTitle=Remove StreamZH
UninstallAppFullTitle=Remove %1
UninstallStatusLabel=Please wait while %1 is removed from your computer.
UninstalledAll=%1 was removed from your computer.

[Tasks]
; The wizard shows these on its own page ("How should StreamZH run?"); the names are for /TASKS and upgrades.
Name: "service"; Description: "As a Windows service (recommended)"; Flags: exclusive
Name: "trayonly"; Description: "Only while I am signed in (tray icon)"; Flags: exclusive unchecked
Name: "firewall"; Description: "Let other devices on my network open StreamZH"; Flags: unchecked
Name: "cfa"; Description: "Allow StreamZH in Controlled folder access"; Flags: unchecked
Name: "desktopicon"; Description: "Add a desktop shortcut"; Flags: unchecked

[InstallDelete]
; The web UI's files have hashed names; remove the old ones on upgrade.
Type: filesandordirs; Name: "{app}\wwwroot"
; The Start menu folder of 1.0.0-rc.1 (the shortcuts are directly in the Start menu now).
Type: files; Name: "{group}\StreamZH.url"
Type: files; Name: "{group}\StreamZH tray icon.lnk"
Type: dirifempty; Name: "{group}"
Type: files; Name: "{autodesktop}\StreamZH.url"; Tasks: not desktopicon

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Excludes: "install-linux.sh,*.pdb"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#RepoDir}\tools\ServiceHelpers.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion
Source: "{#RepoDir}\tools\Install-Service.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion
Source: "{#RepoDir}\tools\Install-Tray.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion
Source: "{#RepoDir}\tools\Uninstall-Service.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion
Source: "{#RepoDir}\src\StreamZH.Tray\streamzh.ico"; DestDir: "{app}"; Flags: ignoreversion
; The logo in the uninstaller's question.
Source: "{#Images}wizard-small-124.png"; DestDir: "{app}"; DestName: "streamzh.png"; Flags: ignoreversion
Source: "{#RepoDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoDir}\NOTICE.md"; DestDir: "{app}"; Flags: ignoreversion
; Tells StreamZH's update check that the setup installed it (it then offers the setup of a new version).
Source: "{#SourcePath}\package-type"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
; "StreamZH" opens the web interface in the browser.
Name: "{autoprograms}\StreamZH"; Filename: "{#WebUi}"; IconFilename: "{app}\streamzh.ico"
Name: "{autodesktop}\StreamZH"; Filename: "{#WebUi}"; IconFilename: "{app}\streamzh.ico"; Tasks: desktopicon
; Tray only: the tray icon also starts StreamZH (--start). Service: it shows the service.
Name: "{autoprograms}\StreamZH tray icon"; Filename: "{app}\StreamZH.Tray.exe"; Parameters: "--start"; Comment: "Starts StreamZH and shows it in the notification area"; Check: IsTrayOnly
Name: "{autoprograms}\StreamZH tray icon"; Filename: "{app}\StreamZH.Tray.exe"; Comment: "Shows StreamZH in the notification area"; Check: not IsTrayOnly

[Run]
; "Start StreamZH" (one check box; the entry that fits the choice is shown). Silent installs run it too.
; Service: start the service as administrator; StartedService then checks it and starts the tray icon for the user.
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ""try {{ Start-Service -Name StreamZH -ErrorAction Stop; exit 0 } catch {{ exit 1 }"""; Description: "Start StreamZH"; Flags: postinstall runhidden runascurrentuser; Check: StartServiceNow; AfterInstall: StartedService
; Tray only: start the tray icon as the signed-in user (not elevated); it starts StreamZH. Never as SYSTEM.
Filename: "{app}\StreamZH.Tray.exe"; Parameters: "--start"; Description: "Start StreamZH"; Flags: postinstall nowait runasoriginaluser; Check: StartTrayNow
; Wait until StreamZH answers, then open it in the browser.
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ""for ($i = 0; $i -lt 60; $i++) {{ try {{ if ((Invoke-WebRequest -Uri '{#WebUi}/health' -UseBasicParsing -TimeoutSec 2).StatusCode -eq 200) {{ break } } catch {{ }; Start-Sleep -Seconds 1 }; Start-Process '{#WebUi}'"""; Description: "Open StreamZH in my browser"; Flags: postinstall nowait runhidden runasoriginaluser skipifsilent; Check: CanStart

[Code]
var
  { "How should StreamZH run?" }
  ModePage: TWizardPage;
  ServiceRadio, TrayRadio: TNewRadioButton;
  FirewallCheck, CfaCheck, DesktopCheck: TNewCheckBox;
  { "Where are your movies and series?" (service only) }
  FoldersPage: TWizardPage;
  OtherDriveRadio, UserFoldersRadio, CustomRadio: TNewRadioButton;
  UserFoldersNote: TNewStaticText;
  FolderEdits: array of TNewEdit;
  BrowseButtons: array of TNewButton;
  { Upgrade: "Change how StreamZH runs" on the Welcome page. }
  ChangeCheck: TNewCheckBox;
  LicenseLink: TNewLinkLabel;

  PreviousExe, PreviousVersion: string;
  ScriptFailed: Boolean;
  DeleteData, AskedUninstall: Boolean;
  { Tray only, upgraded by a setup that runs as SYSTEM: only the files are replaced (SV4 X-05). }
  FilesOnly: Boolean;
  SystemChecked, SystemAccount: Boolean;
  UpgradeChecked, WasInstalled: Boolean;

const
  FolderCount = 3;
  ServiceKey = 'SYSTEM\CurrentControlSet\Services\StreamZH';
  UninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{80733154-B4A9-4387-94A6-31794276A4B5}_is1';
  ShellFoldersKey = 'Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders';
  DownloadsFolderId = '{374DE290-123F-4565-9164-39C4925E467B}';
  VideosFolderId = '{18989B1D-99B5-455B-841C-AB7C74E4DDFC}';
  NoFileAttributes = $FFFFFFFF;
  { Text colours (BGR): muted notes, readable on the light and the dark wizard; warnings in the StreamZH reds
    (#C0202A on light, #F0625A on dark). }
  NoteColor = $8A8A8A;
  WarningColorLight = $2A20C0;
  WarningColorDark = $5A62F0;

function GetFileAttributes(lpFileName: string): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

function SetEnvironmentVariable(lpName: string; lpValue: string): BOOL;
  external 'SetEnvironmentVariableW@kernel32.dll stdcall';

{ A value as a PowerShell string literal: 'it''s'. PowerShell also ends a single-quoted string at the typographic
  quotes U+2018 to U+201B, so those are doubled too (SV4 X-04). }
function PsQuote(Value: string): string;
begin
  StringChangeEx(Value, '''', '''''', True);
  StringChangeEx(Value, #$2018, #$2018#$2018, True);
  StringChangeEx(Value, #$2019, #$2019#$2019, True);
  StringChangeEx(Value, #$201A, #$201A#$201A, True);
  StringChangeEx(Value, #$201B, #$201B#$201B, True);
  Result := '''' + Value + '''';
end;

{ Gives a text its own colour, also under the dark style (which otherwise sets the font colour). Not with high
  contrast, where Windows' colours must stay. }
procedure SetTextColor(Text: TNewStaticText; Color: TColor);
begin
  if HighContrastActive() then
    Exit;
  Text.StyleElements := [seClient, seBorder];
  Text.Font.Color := Color;
end;

function WarningColor(): TColor;
begin
  if IsDarkInstallMode() then
    Result := WarningColorDark
  else
    Result := WarningColorLight;
end;

function PowerShellExe(): string;
begin
  Result := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
end;

function DataDir(): string;
begin
  Result := ExpandConstant('{commonappdata}\StreamZH');
end;

function IsTrayOnly(): Boolean;
begin
  Result := WizardIsTaskSelected('trayonly');
end;

{ True when the setup runs as LocalSystem (S-1-5-18), as deployment tools run it. Asked once. }
function RunsAsSystem(): Boolean;
var
  Code: Integer;
begin
  if not SystemChecked then
  begin
    SystemChecked := True;
    SystemAccount := Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' +
      'if ([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -eq ''S-1-5-18'') { exit 18 }; exit 0"',
      '', SW_HIDE, ewWaitUntilTerminated, Code) and (Code = 18);
    Log('Setup runs as SYSTEM: ' + IntToStr(Ord(SystemAccount)));
  end;
  Result := SystemAccount;
end;

{ "Start StreamZH" and "Open StreamZH in my browser" make sense only when the script finished. }
function CanStart(): Boolean;
begin
  Result := not ScriptFailed and not FilesOnly;
end;

{ The [Run] entry that starts the service ("Start StreamZH" in service mode). }
function StartServiceNow(): Boolean;
begin
  Result := not IsTrayOnly() and CanStart();
end;

{ The [Run] entry that starts the tray icon (and with it StreamZH) after a tray-only install. }
function StartTrayNow(): Boolean;
begin
  Result := IsTrayOnly() and CanStart() and not RunsAsSystem();
end;

{ The program folder of the installed copy ('' when StreamZH is not installed). }
function PreviousAppDir(): string;
begin
  if not RegQueryStringValue(HKLM, UninstallKey, 'Inno Setup: App Path', Result) then
    Result := '';
end;

{ True when StreamZH was installed before this setup started (asked once: the setup writes the same key). }
function IsUpgrade(): Boolean;
begin
  if not UpgradeChecked then
  begin
    UpgradeChecked := True;
    WasInstalled := PreviousAppDir() <> '';
  end;
  Result := WasInstalled;
end;

{ True when Folder is inside C:\Program Files (or C:\Program Files (x86)), which only administrators may change. }
function InProgramFiles(Folder: string): Boolean;
var
  Full: string;
begin
  Full := Lowercase(AddBackslash(ExpandFileName(Folder)));
  Result := (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf64}'))), Full) = 1) or
    (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf32}'))), Full) = 1);
end;

function HasParam(Name: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount() do
    if CompareText(ParamStr(I), Name) = 0 then
      Result := True;
end;

function CustomDirAllowed(): Boolean;
begin
  Result := HasParam('/ALLOWCUSTOMDIR');
end;

function IsLink(Path: string): Boolean;
var
  Attributes: Cardinal;
begin
  Attributes := GetFileAttributes(Path);
  Result := (Attributes <> NoFileAttributes) and ((Attributes and FILE_ATTRIBUTE_REPARSE_POINT) <> 0);
end;

function IsEmptyDir(Dir: string): Boolean;
var
  FindRec: TFindRec;
begin
  Result := True;
  if FindFirst(AddBackslash(Dir) + '*', FindRec) then
  try
    repeat
      if (FindRec.Name <> '.') and (FindRec.Name <> '..') then
      begin
        Result := False;
        Exit;
      end;
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
end;

function RunTool(Exe, Arguments: string): Boolean;
var
  Code: Integer;
begin
  Result := Exec(Exe, Arguments, '', SW_HIDE, ewWaitUntilTerminated, Code) and (Code = 0);
  Log(ExtractFileName(Exe) + ' ' + Arguments + ': exit code ' + IntToStr(Code));
end;

{ Why the program folder cannot be used, or '' (SV4 X-06). The setup runs scripts from it as administrator and the
  service runs StreamZH.exe from it, so nobody but administrators may change it. Inside Program Files that is so.
  Another folder needs /ALLOWCUSTOMDIR and is made administrators-only before any file is copied: never a link; the
  installed copy's own folder is kept (owner Administrators, inheritance cut); otherwise it must be new or empty and is
  created anew with its access list in the same step (owner Administrators; SYSTEM and Administrators full control,
  Users read and run; nothing inherited, so no "Authenticated Users: Modify" from the drive), and the owner is checked
  afterwards. Install-Service.ps1 adds the service account later. }
function CheckProgramFolder(): string;
var
  Dir: string;
  Code: Integer;
begin
  Result := '';
  Dir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  if InProgramFiles(Dir) then
    Exit;
  if not CustomDirAllowed() then
  begin
    Result := 'StreamZH must be installed inside ' + ExpandConstant('{commonpf64}') + ', where only administrators ' +
      'may change the program. ' + Dir + ' is not. To use another folder anyway, start the setup with /ALLOWCUSTOMDIR; ' +
      'the setup then makes that folder administrators-only.';
    Exit;
  end;
  if IsLink(Dir) then
  begin
    Result := Dir + ' is a junction or symbolic link. Choose a real folder.';
    Exit;
  end;

  if DirExists(Dir) and (CompareText(Dir, RemoveBackslashUnlessRoot(PreviousAppDir())) = 0) then
  begin
    { The installed copy's folder: keep its entries (Install-Service.ps1 added the service account). }
    if not RunTool(ExpandConstant('{sys}\takeown.exe'), '/F "' + Dir + '" /A') or
       not RunTool(ExpandConstant('{sys}\icacls.exe'), '"' + Dir + '" /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F ' +
         '*S-1-5-32-544:(OI)(CI)F *S-1-5-32-545:(OI)(CI)RX /Q') then
      Result := 'The folder ' + Dir + ' could not be made administrators-only (see the setup log).';
    Exit;
  end;

  if DirExists(Dir) and not IsEmptyDir(Dir) then
  begin
    Result := Dir + ' already holds files. Choose a new or empty folder for StreamZH.';
    Exit;
  end;

  { The path reaches PowerShell as an environment variable, never as code. }
  if not SetEnvironmentVariable('STREAMZH_SETUP_DIR', Dir) then
  begin
    Result := 'The folder ' + Dir + ' could not be prepared.';
    Exit;
  end;
  if not Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' +
    '$d = $env:STREAMZH_SETUP_DIR; ' +
    'if (Test-Path -LiteralPath $d) { [IO.Directory]::Delete($d, $false) }; ' +
    '$s = New-Object Security.AccessControl.DirectorySecurity; ' +
    '$s.SetSecurityDescriptorSddlForm(''O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)''); ' +
    '[void][IO.Directory]::CreateDirectory($d, $s); ' +
    '$i = Get-Item -LiteralPath $d -Force; if ($i.Attributes -band [IO.FileAttributes]::ReparsePoint) { exit 5 }; ' +
    'if ((Get-Acl -LiteralPath $d).GetOwner([Security.Principal.SecurityIdentifier]).Value -ne ''S-1-5-32-544'') { exit 4 }; ' +
    'if (@(Get-ChildItem -LiteralPath $d -Force).Count -ne 0) { exit 3 }; exit 0"',
    '', SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
    Result := 'The folder ' + Dir + ' could not be created as an administrators-only folder (exit code ' +
      IntToStr(Code) + '). Choose another folder, or install to ' + ExpandConstant('{commonpf64}') + '.';
  Log('Program folder ' + Dir + ' created administrators-only: exit code ' + IntToStr(Code));
end;

{ The program of a service command line: "C:\Tools\StreamZH\StreamZH.exe" --data "..." -> C:\Tools\StreamZH\StreamZH.exe }
function ExeOf(CommandLine: string): string;
var
  P: Integer;
begin
  CommandLine := Trim(CommandLine);
  if (Length(CommandLine) > 0) and (CommandLine[1] = '"') then
  begin
    Delete(CommandLine, 1, 1);
    P := Pos('"', CommandLine);
  end
  else
    P := Pos(' ', CommandLine);
  if P > 0 then
    Result := Copy(CommandLine, 1, P - 1)
  else
    Result := CommandLine;
end;

function ServiceExe(): string;
var
  ImagePath: string;
begin
  Result := '';
  if RegQueryStringValue(HKLM, ServiceKey, 'ImagePath', ImagePath) then
    Result := ExeOf(ImagePath);
end;

{ ---- Media folders (service only) ---- }

{ A known folder of the user who runs the setup (Videos, Downloads), or '' when it does not exist. }
function UserFolder(ValueName: string): string;
var
  Raw: string;
begin
  Result := '';
  if RegQueryStringValue(HKCU, ShellFoldersKey, ValueName, Raw) then
  begin
    StringChangeEx(Raw, '%USERPROFILE%', GetEnv('USERPROFILE'), True);
    if Pos('%', Raw) = 0 then
      Result := RemoveBackslashUnlessRoot(Raw);
  end;
  if (Result <> '') and not DirExists(Result) then
    Result := '';
end;

function VideosFolder(): string;
begin
  { Windows names the value "My Video"; a moved folder may also have its known-folder ID (Wine: "My Videos"). }
  Result := UserFolder('My Video');
  if Result = '' then
    Result := UserFolder(VideosFolderId);
  if Result = '' then
    Result := UserFolder('My Videos');
end;

function DownloadsFolder(): string;
begin
  Result := UserFolder(DownloadsFolderId);
end;

{ Adds Item to List (a ;-separated list) unless it is empty or already there. }
procedure AddFolder(var List: string; Item: string);
begin
  Item := Trim(Item);
  StringChangeEx(Item, '"', '', True);
  if (Item <> '') and (Pos(';' + Lowercase(Item) + ';', ';' + Lowercase(List)) = 0) then
    List := List + Item + ';';
end;

{ The folders the service account may change: the choice on the folders page plus /FOLDERS="D:\Media;D:\Downloads". }
function SelectedFolders(): TArrayOfString;
var
  All, Rest: string;
  I, P: Integer;
begin
  All := '';
  if UserFoldersRadio.Checked then
  begin
    AddFolder(All, VideosFolder());
    AddFolder(All, DownloadsFolder());
  end
  else if CustomRadio.Checked then
    for I := 0 to FolderCount - 1 do
      AddFolder(All, FolderEdits[I].Text);
  Rest := ExpandConstant('{param:FOLDERS|}') + ';';
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    AddFolder(All, Copy(Rest, 1, P - 1));
    Delete(Rest, 1, P);
  end;
  SetArrayLength(Result, 0);
  while All <> '' do
  begin
    P := Pos(';', All);
    SetArrayLength(Result, GetArrayLength(Result) + 1);
    Result[GetArrayLength(Result) - 1] := Copy(All, 1, P - 1);
    Delete(All, 1, P);
  end;
end;

{ ---- Wizard pages ---- }

{ A muted note below a radio button or check box. }
function NewNote(Page: TWizardPage; Control: TWinControl; Text: string): TNewStaticText;
begin
  Result := TNewStaticText.Create(Page);
  Result.Parent := Page.Surface;
  Result.Left := Control.Left + ScaleX(18);
  Result.Top := Control.Top + Control.Height + ScaleY(1);
  Result.Width := Page.SurfaceWidth - Result.Left;
  Result.WordWrap := True;
  Result.Caption := Text;
  SetTextColor(Result, NoteColor);
  Result.AdjustHeight();
end;

{ The same; returns the top of the next row. }
function AddNote(Page: TWizardPage; Control: TWinControl; Text: string): Integer;
var
  Note: TNewStaticText;
begin
  Note := NewNote(Page, Control, Text);
  Result := Note.Top + Note.Height;
end;

function NewRadio(Page: TWizardPage; Top: Integer; Caption: string; Bold: Boolean): TNewRadioButton;
begin
  Result := TNewRadioButton.Create(Page);
  Result.Parent := Page.Surface;
  Result.Left := 0;
  Result.Top := Top;
  Result.Width := Page.SurfaceWidth;
  Result.Height := ScaleY(17);
  Result.Caption := Caption;
  if Bold then
    Result.Font.Style := [fsBold];
end;

function NewCheck(Page: TWizardPage; Top: Integer; Caption: string): TNewCheckBox;
begin
  Result := TNewCheckBox.Create(Page);
  Result.Parent := Page.Surface;
  Result.Left := 0;
  Result.Top := Top;
  Result.Width := Page.SurfaceWidth;
  Result.Height := ScaleY(17);
  Result.Caption := Caption;
end;

procedure CreateModePage();
var
  Top: Integer;
  Heading: TNewStaticText;
begin
  ModePage := CreateCustomPage(wpSelectTasks, 'How should StreamZH run?',
    'You can change this later by running the setup again.');

  ServiceRadio := NewRadio(ModePage, 0, 'As a &Windows service (recommended)', True);
  Top := AddNote(ModePage, ServiceRadio,
    'Runs in the background and starts with Windows, also when nobody is signed in.');
  TrayRadio := NewRadio(ModePage, Top + ScaleY(12), 'Only while I am &signed in', True);
  Top := AddNote(ModePage, TrayRadio,
    'Starts with the tray icon when you sign in and stops when you sign out. Uses your own folders and network drives.');

  Heading := TNewStaticText.Create(ModePage);
  Heading.Parent := ModePage.Surface;
  Heading.Top := Top + ScaleY(20);
  Heading.Caption := 'Options';
  Heading.Font.Style := [fsBold];
  Top := Heading.Top + Heading.Height + ScaleY(8);

  FirewallCheck := NewCheck(ModePage, Top, 'Let other &devices on my network open StreamZH');
  Top := AddNote(ModePage, FirewallCheck, 'Allows port 9797 in the Windows Firewall, for private networks only.');
  CfaCheck := NewCheck(ModePage, Top + ScaleY(8), 'Allow StreamZH in &Controlled folder access');
  Top := AddNote(ModePage, CfaCheck, 'Only needed when Ransomware protection is on in Windows Security.');
  DesktopCheck := NewCheck(ModePage, Top + ScaleY(8), 'Add a des&ktop shortcut');
end;

procedure UpdateFolderControls(Sender: TObject);
var
  I: Integer;
begin
  for I := 0 to FolderCount - 1 do
  begin
    FolderEdits[I].Enabled := CustomRadio.Checked;
    BrowseButtons[I].Enabled := CustomRadio.Checked;
  end;
end;

procedure BrowseClick(Sender: TObject);
var
  Index: Integer;
  Folder: string;
begin
  Index := TNewButton(Sender).Tag;
  Folder := FolderEdits[Index].Text;
  if BrowseForFolder('Choose a folder StreamZH may use:', Folder, False) then
    FolderEdits[Index].Text := Folder;
end;

procedure CreateFoldersPage();
var
  I, Top: Integer;
  Footer: TNewStaticText;
  Choice: string;
begin
  FoldersPage := CreateCustomPage(ModePage.ID, 'Where are your movies and series?',
    'The service may only change folders it is allowed to use.');

  OtherDriveRadio := NewRadio(FoldersPage, 0, 'On &another drive or a network share', False);
  Top := AddNote(FoldersPage, OtherDriveRadio,
    'For example D:\Media or \\nas\media. Nothing to set up here.');
  UserFoldersRadio := NewRadio(FoldersPage, Top + ScaleY(10), 'In my &Videos and Downloads folders', False);
  UserFoldersNote := NewNote(FoldersPage, UserFoldersRadio, 'StreamZH may use these two folders of your user.');
  Top := UserFoldersNote.Top + UserFoldersNote.Height;
  CustomRadio := NewRadio(FoldersPage, Top + ScaleY(10), 'In &other folders on this PC:', False);
  Top := CustomRadio.Top + CustomRadio.Height + ScaleY(6);

  SetArrayLength(FolderEdits, FolderCount);
  SetArrayLength(BrowseButtons, FolderCount);
  for I := 0 to FolderCount - 1 do
  begin
    BrowseButtons[I] := TNewButton.Create(FoldersPage);
    BrowseButtons[I].Parent := FoldersPage.Surface;
    BrowseButtons[I].Caption := 'Browse...';
    BrowseButtons[I].Tag := I;
    BrowseButtons[I].Width := ScaleX(80);
    BrowseButtons[I].Height := ScaleY(23);
    BrowseButtons[I].Left := FoldersPage.SurfaceWidth - BrowseButtons[I].Width;
    BrowseButtons[I].Top := Top;
    BrowseButtons[I].OnClick := @BrowseClick;
    FolderEdits[I] := TNewEdit.Create(FoldersPage);
    FolderEdits[I].Parent := FoldersPage.Surface;
    FolderEdits[I].Left := ScaleX(18);
    FolderEdits[I].Top := Top + ScaleY(1);
    FolderEdits[I].Width := BrowseButtons[I].Left - FolderEdits[I].Left - ScaleX(8);
    FolderEdits[I].Text := GetPreviousData('Folder' + IntToStr(I), '');
    Top := Top + BrowseButtons[I].Height + ScaleY(6);
  end;

  Footer := TNewStaticText.Create(FoldersPage);
  Footer.Parent := FoldersPage.Surface;
  Footer.Top := Top + ScaleY(8);
  Footer.Width := FoldersPage.SurfaceWidth;
  Footer.WordWrap := True;
  SetTextColor(Footer, NoteColor);
  Footer.Caption := 'Mapped drives (Z:) are not visible to the service: use \\server\share paths in StreamZH. ' +
    'To change this later, run the setup again.';
  Footer.AdjustHeight();

  { The choice of the last installation; an older installation with folders counts as "other folders". }
  Choice := GetPreviousData('MediaFolders', '');
  if (Choice = '') and (FolderEdits[0].Text + FolderEdits[1].Text + FolderEdits[2].Text <> '') then
    Choice := 'custom';
  if Choice = 'user' then
    UserFoldersRadio.Checked := True
  else if Choice = 'custom' then
    CustomRadio.Checked := True
  else
    OtherDriveRadio.Checked := True;
  OtherDriveRadio.OnClick := @UpdateFolderControls;
  UserFoldersRadio.OnClick := @UpdateFolderControls;
  CustomRadio.OnClick := @UpdateFolderControls;
  UpdateFolderControls(nil);
end;

procedure LicenseLinkClick(Sender: TObject; const Link: string; LinkType: TSysLinkType);
var
  Code: Integer;
begin
  ShellExecAsOriginalUser('open', Link, '', '', SW_SHOWNORMAL, ewNoWait, Code);
end;

procedure CreateWelcomeExtras();
begin
  { Upgrade: the remembered choices are used unless this box is ticked. }
  ChangeCheck := TNewCheckBox.Create(WizardForm);
  ChangeCheck.Parent := WizardForm.WelcomePage;
  ChangeCheck.Left := WizardForm.WelcomeLabel2.Left;
  ChangeCheck.Width := WizardForm.WelcomeLabel2.Width;
  ChangeCheck.Height := ScaleY(17);
  ChangeCheck.Caption := '&Change how StreamZH runs and which folders it may use';
  ChangeCheck.Visible := False;

  LicenseLink := TNewLinkLabel.Create(WizardForm);
  LicenseLink.Parent := WizardForm.WelcomePage;
  LicenseLink.AutoSize := False;
  LicenseLink.Left := WizardForm.WelcomeLabel2.Left;
  LicenseLink.Width := WizardForm.WelcomeLabel2.Width;
  LicenseLink.Caption := 'StreamZH is free and open-source software under the ' +
    '<a href="{#AppUrl}/blob/main/LICENSE">GNU General Public License v3</a>.';
  LicenseLink.OnLinkClick := @LicenseLinkClick;
end;

procedure InitializeWizard();
begin
  RegQueryStringValue(HKLM, UninstallKey, 'DisplayVersion', PreviousVersion);
  IsUpgrade();
  CreateWelcomeExtras();
  CreateModePage();
  CreateFoldersPage();
end;

procedure RegisterPreviousData(PreviousDataKey: Integer);
var
  I: Integer;
  Choice: string;
begin
  for I := 0 to FolderCount - 1 do
    SetPreviousData(PreviousDataKey, 'Folder' + IntToStr(I), FolderEdits[I].Text);
  if UserFoldersRadio.Checked then
    Choice := 'user'
  else if CustomRadio.Checked then
    Choice := 'custom'
  else
    Choice := 'other';
  SetPreviousData(PreviousDataKey, 'MediaFolders', Choice);
end;

{ Upgrades skip the choice pages unless "Change how StreamZH runs" is ticked. }
function ShowChoices(): Boolean;
begin
  Result := not IsUpgrade() or ChangeCheck.Checked;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = wpSelectDir then
    Result := not CustomDirAllowed()
  else if PageID = wpSelectTasks then
    { The tasks are set on the "How should StreamZH run?" page. }
    Result := True
  else if PageID = ModePage.ID then
    Result := not ShowChoices()
  else if PageID = FoldersPage.ID then
    Result := not ShowChoices() or IsTrayOnly();
end;

procedure CurPageChanged(CurPageID: Integer);
var
  Text: string;
begin
  if CurPageID = wpWelcome then
  begin
    if IsUpgrade() then
    begin
      WizardForm.WelcomeLabel1.Caption := 'Update StreamZH';
      if (PreviousVersion <> '') and (PreviousVersion <> '{#AppVersion}') then
        Text := 'This updates StreamZH ' + PreviousVersion + ' to {#AppVersion}.'
      else
        Text := 'This installs StreamZH {#AppVersion} again.';
      Text := Text + #13#10#13#10 + 'Your library, settings and history stay as they are. StreamZH is closed ' +
        'during the update and starts again when it is done.';
    end
    else
      Text := SetupMessage(msgWelcomeLabel2);
    { Without Inno Setup's "Click Next to continue" line. }
    WizardForm.WelcomeLabel2.Caption := Text;
    WizardForm.WelcomeLabel2.AdjustHeight();
    ChangeCheck.Top := WizardForm.WelcomeLabel2.Top + WizardForm.WelcomeLabel2.Height + ScaleY(16);
    ChangeCheck.Visible := IsUpgrade();
    LicenseLink.AdjustHeight();
    LicenseLink.Top := WizardForm.WelcomePage.Height - LicenseLink.Height - ScaleY(16);
  end
  else if CurPageID = ModePage.ID then
  begin
    ServiceRadio.Checked := not IsTrayOnly();
    TrayRadio.Checked := IsTrayOnly();
    FirewallCheck.Checked := WizardIsTaskSelected('firewall');
    CfaCheck.Checked := WizardIsTaskSelected('cfa');
    DesktopCheck.Checked := WizardIsTaskSelected('desktopicon');
  end
  else if CurPageID = FoldersPage.ID then
  begin
    { The two folders of this user, so it is clear which ones. }
    if (VideosFolder() <> '') and (DownloadsFolder() <> '') then
      UserFoldersNote.Caption := VideosFolder() + ' and ' + DownloadsFolder()
    else if VideosFolder() + DownloadsFolder() <> '' then
      UserFoldersNote.Caption := VideosFolder() + DownloadsFolder();
  end
  else if CurPageID = wpReady then
  begin
    if IsUpgrade() then
    begin
      WizardForm.PageNameLabel.Caption := 'Ready to update';
      if (PreviousVersion <> '') and (PreviousVersion <> '{#AppVersion}') then
        WizardForm.PageDescriptionLabel.Caption := 'Setup is ready to update StreamZH ' + PreviousVersion +
          ' to {#AppVersion}.'
      else
        WizardForm.PageDescriptionLabel.Caption := 'Setup is ready to install StreamZH {#AppVersion} again.';
      WizardForm.ReadyLabel.Caption := 'Click Update to continue.';
      WizardForm.NextButton.Caption := '&Update';
    end;
  end
  else if CurPageID = wpFinished then
  begin
    if IsUpgrade() then
      Text := 'StreamZH {#AppVersion} is installed. Your library and settings are as you left them.'
    else if IsTrayOnly() then
      Text := 'StreamZH starts with the tray icon when you sign in.'
    else
      Text := 'StreamZH runs in the background and starts with Windows.';
    if not IsUpgrade() then
      Text := Text + #13#10#13#10 + 'Open it any time from the Start menu (StreamZH). On the first visit you ' +
        'create your account.';
    if (PreviousExe <> '') and (CompareText(ExtractFileDir(PreviousExe), ExpandConstant('{app}')) <> 0) then
      Text := Text + #13#10#13#10 + 'StreamZH now runs from ' + ExpandConstant('{app}') + '. The old program folder ' +
        ExtractFileDir(PreviousExe) + ' is no longer used; you can delete it (your data is not in it).';
    if FilesOnly then
      Text := Text + #13#10#13#10 + 'The program was replaced; StreamZH starts with the tray icon at the next sign-in.';
    if ScriptFailed then
      Text := Text + #13#10#13#10 + 'Setting up StreamZH did not finish; see the message before.';
    WizardForm.FinishedLabel.Caption := Text;
    WizardForm.FinishedLabel.AdjustHeight();
    { "Start StreamZH" and "Open StreamZH in my browser" below the text, however long it is. }
    WizardForm.RunList.Hide();
    WizardForm.RunList.Top := WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(16);
    WizardForm.RunList.Show();
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  I, Count: Integer;
  Folder: string;
begin
  Result := True;
  if (CurPageID = wpSelectDir) and not InProgramFiles(WizardDirValue()) and not CustomDirAllowed() then
  begin
    MsgBox('Install StreamZH inside ' + ExpandConstant('{commonpf64}') + ': only administrators may change the ' +
      'program there, and the service runs it. (Another folder needs the setup option /ALLOWCUSTOMDIR.)', mbError, MB_OK);
    Result := False;
  end
  else if CurPageID = ModePage.ID then
  begin
    if TrayRadio.Checked then
      WizardSelectTasks('trayonly,!service')
    else
      WizardSelectTasks('service,!trayonly');
    if FirewallCheck.Checked then WizardSelectTasks('firewall') else WizardSelectTasks('!firewall');
    if CfaCheck.Checked then WizardSelectTasks('cfa') else WizardSelectTasks('!cfa');
    if DesktopCheck.Checked then WizardSelectTasks('desktopicon') else WizardSelectTasks('!desktopicon');
  end
  else if CurPageID = FoldersPage.ID then
  begin
    if UserFoldersRadio.Checked and (VideosFolder() = '') and (DownloadsFolder() = '') then
    begin
      MsgBox('Your Videos and Downloads folders were not found. Choose your folders under "In other folders".',
        mbError, MB_OK);
      Result := False;
      Exit;
    end;
    if not CustomRadio.Checked then
      Exit;
    Count := 0;
    for I := 0 to FolderCount - 1 do
    begin
      Folder := Trim(FolderEdits[I].Text);
      if Folder = '' then
        Continue;
      Count := Count + 1;
      if (Copy(Folder, 1, 2) <> '\\') and not DirExists(Folder) then
      begin
        MsgBox('The folder ' + Folder + ' does not exist.', mbError, MB_OK);
        Result := False;
        Exit;
      end;
    end;
    if Count = 0 then
    begin
      MsgBox('Enter at least one folder, or choose another answer.', mbError, MB_OK);
      Result := False;
    end;
  end;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo, MemoComponentsInfo,
  MemoGroupInfo, MemoTasksInfo: String): String;
var
  Folders: TArrayOfString;
  Options: string;
  I: Integer;
begin
  Result := 'StreamZH runs' + NewLine + Space;
  if IsTrayOnly() then
    Result := Result + 'Only while you are signed in (tray icon)'
  else
    Result := Result + 'As a Windows service';
  Result := Result + NewLine + NewLine;

  if not IsTrayOnly() then
  begin
    Folders := SelectedFolders();
    Result := Result + 'Folders the service may change' + NewLine;
    if GetArrayLength(Folders) = 0 then
      Result := Result + Space + 'No extra folders (another drive or a network share)' + NewLine;
    for I := 0 to GetArrayLength(Folders) - 1 do
      Result := Result + Space + Folders[I] + NewLine;
    Result := Result + NewLine;
  end;

  Options := '';
  if WizardIsTaskSelected('firewall') then
    Options := Options + Space + 'Other devices on private networks may open StreamZH (port 9797)' + NewLine;
  if WizardIsTaskSelected('cfa') then
    Options := Options + Space + 'Allowed in Controlled folder access' + NewLine;
  if WizardIsTaskSelected('desktopicon') then
    Options := Options + Space + 'Desktop shortcut' + NewLine;
  if Options <> '' then
    Result := Result + 'Options' + NewLine + Options + NewLine;

  Result := Result + 'Program' + NewLine + Space + ExpandConstant('{app}') + NewLine + NewLine +
    'Your data' + NewLine + Space + DataDir();
end;

{ Refuses what must not be installed (tray only as SYSTEM, a program folder others may change), then stops the
  service, the tray icons and a StreamZH in a console window, so the files can be replaced. }
function PrepareToInstall(var NeedsRestart: Boolean): string;
var
  Code: Integer;
begin
  Result := '';
  if IsTrayOnly() and RunsAsSystem() then
  begin
    { A new installation, or a switch from the service to tray only, needs the user's session. }
    if (PreviousAppDir() = '') or (ServiceExe() <> '') then
    begin
      Result := '"Tray only" cannot be installed by a setup that runs as SYSTEM (a deployment tool such as Intune or ' +
        'SCCM): StreamZH would run as SYSTEM, and the tray icon belongs to the user who signs in. Use /TASKS="service", ' +
        'or run the setup as administrator in the user''s session.';
      Exit;
    end;
    { Upgrade of a tray-only installation: replace the files; the user's tray icon starts StreamZH at the next sign-in. }
    FilesOnly := True;
    Log('Tray only, setup as SYSTEM: only the files are replaced');
  end;
  Result := CheckProgramFolder();
  if Result <> '' then
    Exit;

  PreviousExe := ServiceExe();
  Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' +
    'Stop-Service -Name StreamZH -Force -ErrorAction SilentlyContinue; ' +
    '$p = Get-Process -Name StreamZH, StreamZH.Tray -ErrorAction SilentlyContinue; ' +
    'if ($p) { $p | Stop-Process -Force -ErrorAction SilentlyContinue; $p | Wait-Process -Timeout 30 -ErrorAction SilentlyContinue }"',
    '', SW_HIDE, ewWaitUntilTerminated, Code);
  Log('Stopped StreamZH (exit code ' + IntToStr(Code) + ')');
end;

{ Runs tools\<Script> with the arguments; its output goes into the setup log. False when it failed. }
function RunScript(Script, Arguments: string; var Output: string): Boolean;
var
  LogFile: string;
  Lines: TArrayOfString;
  Code, I: Integer;
begin
  LogFile := ExpandConstant('{tmp}\') + Script + '.log';
  Log('Running ' + Script + ' ' + Arguments);
  Result := Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "& ' +
    PsQuote(ExpandConstant('{app}\tools\') + Script) + ' ' + Arguments + ' *>&1 | Out-File -FilePath ' +
    PsQuote(LogFile) + ' -Encoding utf8 -Width 400; exit $LASTEXITCODE"', '', SW_HIDE, ewWaitUntilTerminated, Code)
    and (Code = 0);
  Output := '';
  if LoadStringsFromFile(LogFile, Lines) then
    for I := 0 to GetArrayLength(Lines) - 1 do
    begin
      Log(Lines[I]);
      if I >= GetArrayLength(Lines) - 12 then
        Output := Output + Lines[I] + #13#10;
    end;
  Log(Script + ' exit code ' + IntToStr(Code));
end;

{ The folders for the service in a new file in a new folder with a unique name in the setup's own temporary folder
  (the tmp constant), one per line: Install-Service.ps1 -FoldersFile reads them, so no folder name is parsed as PowerShell code
  (SV4 X-04). '' when there are none. }
function WriteFoldersFile(Folders: TArrayOfString): string;
var
  Dir: string;
begin
  Result := '';
  if GetArrayLength(Folders) = 0 then
    Exit;
  Dir := GenerateUniqueName(ExpandConstant('{tmp}'), '.dir');
  if not CreateDir(Dir) then
    RaiseException('Could not create ' + Dir);
  Result := AddBackslash(Dir) + 'folders.txt';
  if not SaveStringsToUTF8File(Result, Folders, False) then
    RaiseException('Could not write ' + Result);
end;

{ The uninstaller of Windows' app list asks StreamZH's one question (InitializeUninstall) instead of Inno Setup's
  confirmation: /SILENT skips the confirmation and the final message, /ASK shows StreamZH's dialog and message.
  unins000.exe without parameters still works (Inno Setup's confirmation, then the dialog). }
procedure UseStreamZhUninstallDialog();
var
  Command: string;
begin
  Command := '"' + ExpandConstant('{uninstallexe}') + '" /SILENT /ASK';
  if RegWriteStringValue(HKLM, UninstallKey, 'UninstallString', Command) then
    Log('UninstallString: ' + Command)
  else
    Log('UninstallString could not be changed');
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Arguments, Script, Output, FoldersFile: string;
begin
  if CurStep = ssDone then
    { The uninstall entry is written at the end of the installation; set it again in case it was rewritten. }
    UseStreamZhUninstallDialog();
  if CurStep <> ssPostInstall then
    Exit;
  UseStreamZhUninstallDialog();
  if FilesOnly then
  begin
    Log('Files replaced; Install-Tray.ps1 not run (setup as SYSTEM)');
    Exit;
  end;

  { StreamZH is started by "Start StreamZH" on the Finish page (and by silent installs), not by the script. }
  Arguments := '-InstallDir ' + PsQuote(ExpandConstant('{app}')) + ' -NonInteractive -NoStart';
  if WizardIsTaskSelected('firewall') then
    Arguments := Arguments + ' -Firewall';
  if WizardIsTaskSelected('cfa') then
    Arguments := Arguments + ' -AllowControlledFolderAccess';

  if IsTrayOnly() then
  begin
    Script := 'Install-Tray.ps1';
    WizardForm.StatusLabel.Caption := 'Setting up the tray icon...';
  end
  else
  begin
    Script := 'Install-Service.ps1';
    WizardForm.StatusLabel.Caption := 'Setting up the Windows service...';
    FoldersFile := WriteFoldersFile(SelectedFolders());
    if FoldersFile <> '' then
      Arguments := Arguments + ' -FoldersFile ' + PsQuote(FoldersFile);
  end;

  ScriptFailed := not RunScript(Script, Arguments, Output);
  if FoldersFile <> '' then
    DelTree(ExtractFileDir(FoldersFile), True, True, True);
  if ScriptFailed and not WizardSilent() then
    MsgBox('StreamZH was installed, but setting it up did not finish (' + Script + '):' + #13#10#13#10 +
      Output + #13#10 + 'Run it again in a PowerShell as administrator:' + #13#10 + '& ''' + ExpandConstant('{app}\tools\') +
      Script + '''', mbError, MB_OK);
end;

{ After "Start StreamZH" started the service: tell when it did not start, then start the tray icon as the signed-in
  user (never as SYSTEM; explorer.exe starts it without administrator rights, as Install-Service.ps1 does). }
procedure StartedService();
var
  Code: Integer;
begin
  if not Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' +
    'if ((Get-Service -Name StreamZH -ErrorAction SilentlyContinue).Status -eq ''Running'') { exit 0 }; exit 1"',
    '', SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
  begin
    Log('The service StreamZH did not start');
    if not WizardSilent() then
      MsgBox('The StreamZH service did not start.' + #13#10#13#10 + 'The reason is in the Windows event log ' +
        '(Application, source StreamZH) and in ' + DataDir() + '\logs. Start it again with the tray icon or with ' +
        'Start-Service StreamZH.', mbError, MB_OK);
  end;
  if not RunsAsSystem() then
    Exec(ExpandConstant('{win}\explorer.exe'), '"' + ExpandConstant('{app}\StreamZH.Tray.exe') + '"', '', SW_SHOWNORMAL,
      ewNoWait, Code);
end;

{ ---- Uninstall ---- }

{ /DELETEDATA=1 (or /DELETEDATA) on the uninstaller's command line. }
function DeleteDataRequested(): Boolean;
begin
  Result := HasParam('/DELETEDATA=1') or HasParam('/DELETEDATA');
end;

var
  DataWarning: TNewStaticText;
  DataCheck: TNewCheckBox;

procedure DataCheckClick(Sender: TObject);
begin
  if DataCheck.Checked then
  begin
    DataWarning.Caption := 'Deletes ' + DataDir() + ' for good. Your media files stay.';
    SetTextColor(DataWarning, WarningColor());
  end
  else
  begin
    DataWarning.Caption := 'Your data stays in ' + DataDir() + ' for a later installation.';
    SetTextColor(DataWarning, NoteColor);
  end;
end;

{ StreamZH's one question: remove, and also delete the data? }
function AskUninstall(): Boolean;
var
  Form: TSetupForm;
  Icon: TBitmapImage;
  Heading, Info: TNewStaticText;
  RemoveButton, CancelButton: TNewButton;
  Left, FormWidth, FormHeight: Integer;
begin
  FormWidth := ScaleX(520);
  FormHeight := ScaleY(176);
  Form := CreateCustomForm(FormWidth, FormHeight, True, True);
  try
    { Under Wine at 150 % display scaling the form came out scaled twice; give it the size asked for. }
    if (Form.ClientWidth <> FormWidth) or (Form.ClientHeight <> FormHeight) then
      Form.SetBounds(Form.Left, Form.Top, Form.Width - Form.ClientWidth + FormWidth,
        Form.Height - Form.ClientHeight + FormHeight);
    Form.Caption := 'Remove StreamZH';

    Icon := TBitmapImage.Create(Form);
    Icon.Parent := Form;
    Icon.Left := ScaleX(20);
    Icon.Top := ScaleY(20);
    Icon.Width := ScaleX(48);
    Icon.Height := ScaleY(48);
    Icon.Stretch := True;
    try
      Icon.PngImage.LoadFromFile(ExpandConstant('{app}\streamzh.png'));
    except
      Log('Could not load the logo: ' + GetExceptionMessage());
    end;
    Left := ScaleX(20 + 48 + 16);

    Heading := TNewStaticText.Create(Form);
    Heading.Parent := Form;
    Heading.Left := Left;
    Heading.Top := ScaleY(20);
    Heading.Caption := 'Remove StreamZH from this computer?';
    Heading.Font.Size := Heading.Font.Size + 3;
    Heading.Font.Style := [fsBold];

    Info := TNewStaticText.Create(Form);
    Info.Parent := Form;
    Info.Left := Left;
    Info.Top := Heading.Top + Heading.Height + ScaleY(8);
    Info.Width := FormWidth - Left - ScaleX(20);
    Info.WordWrap := True;
    if RegKeyExists(HKLM, ServiceKey) then
      Info.Caption := 'The program, its Windows service and its tray icon are removed.'
    else
      Info.Caption := 'The program and its tray icon are removed.';
    Info.AdjustHeight();

    DataCheck := TNewCheckBox.Create(Form);
    DataCheck.Parent := Form;
    DataCheck.Left := Left;
    DataCheck.Top := Info.Top + Info.Height + ScaleY(16);
    DataCheck.Width := FormWidth - Left - ScaleX(20);
    DataCheck.Height := ScaleY(17);
    DataCheck.Caption := '&Also delete my data (library, settings and backups)';
    DataCheck.Checked := DeleteData;
    DataCheck.OnClick := @DataCheckClick;

    DataWarning := TNewStaticText.Create(Form);
    DataWarning.Parent := Form;
    DataWarning.Left := Left + ScaleX(18);
    DataWarning.Top := DataCheck.Top + DataCheck.Height + ScaleY(2);
    DataWarning.Width := FormWidth - DataWarning.Left - ScaleX(20);
    DataWarning.WordWrap := True;
    DataCheckClick(nil);

    CancelButton := TNewButton.Create(Form);
    CancelButton.Parent := Form;
    CancelButton.Caption := 'Cancel';
    CancelButton.ModalResult := mrCancel;
    CancelButton.Cancel := True;
    CancelButton.Width := ScaleX(90);
    CancelButton.Height := ScaleY(25);
    CancelButton.Top := FormHeight - CancelButton.Height - ScaleY(16);
    CancelButton.Left := FormWidth - CancelButton.Width - ScaleX(20);

    RemoveButton := TNewButton.Create(Form);
    RemoveButton.Parent := Form;
    RemoveButton.Caption := '&Remove';
    RemoveButton.ModalResult := mrOk;
    RemoveButton.Default := True;
    RemoveButton.Width := ScaleX(90);
    RemoveButton.Height := ScaleY(25);
    RemoveButton.Top := CancelButton.Top;
    RemoveButton.Left := CancelButton.Left - RemoveButton.Width - ScaleX(8);

    Form.ActiveControl := RemoveButton;
    Result := Form.ShowModal() = mrOk;
    DeleteData := DataCheck.Checked;
  finally
    Form.Free();
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := True;
  DeleteData := DeleteDataRequested();
  { /ASK: started from Windows' app list with /SILENT /ASK (see UseStreamZhUninstallDialog). }
  AskedUninstall := HasParam('/ASK') or not UninstallSilent();
  Log('Command line: ' + GetCmdTail() + '; delete data: ' + IntToStr(Ord(DeleteData)) + '; ask: ' +
    IntToStr(Ord(AskedUninstall)));
  if AskedUninstall then
    Result := AskUninstall();
  Log('Delete data: ' + IntToStr(Ord(DeleteData)));
end;

procedure InitializeUninstallProgressForm();
begin
  UninstallProgressForm.PageNameLabel.Caption := 'Removing StreamZH';
  UninstallProgressForm.PageDescriptionLabel.Caption := 'This takes a few seconds.';
  { The StreamZH logo instead of Inno Setup's uninstall picture. }
  try
    UninstallProgressForm.WizardSmallBitmapImage.Stretch := True;
    UninstallProgressForm.WizardSmallBitmapImage.PngImage.LoadFromFile(ExpandConstant('{app}\streamzh.png'));
  except
    Log('Could not load the logo: ' + GetExceptionMessage());
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Code: Integer;
  Text: string;
begin
  if CurUninstallStep = usUninstall then
  begin
    UninstallProgressForm.StatusLabel.Caption := 'Stopping StreamZH and removing the service...';
    { Removes the service, its firewall rule and the tray's "Start with Windows" entry; keeps the data. }
    Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' +
      ExpandConstant('{app}\tools\Uninstall-Service.ps1') + '" -InstallDir "' + ExpandConstant('{app}') +
      '" -NonInteractive', '', SW_HIDE, ewWaitUntilTerminated, Code);
    Log('Uninstall-Service.ps1 exit code ' + IntToStr(Code));
    { A StreamZH started by the tray (no service) and every tray icon. }
    Exec(PowerShellExe(), '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' +
      '$p = Get-Process -Name StreamZH, StreamZH.Tray -ErrorAction SilentlyContinue; ' +
      'if ($p) { $p | Stop-Process -Force -ErrorAction SilentlyContinue; $p | Wait-Process -Timeout 30 -ErrorAction SilentlyContinue }"',
      '', SW_HIDE, ewWaitUntilTerminated, Code);
    { Nothing runs any more that holds the database; the data goes only when the user asked for it. DelTree does not
      follow junctions or symbolic links (the service account or the user could have made one in the data folder): it
      deletes the link itself and leaves its target alone (SV4 X-11; Inno Setup 6.7.0, IsDirectoryAndNotReparsePoint). }
    if DeleteData then
    begin
      UninstallProgressForm.StatusLabel.Caption := 'Deleting your data...';
      if DelTree(DataDir(), True, True, True) then
        Log('Deleted the data folder ' + DataDir())
      else
        Log('Could not delete the data folder ' + DataDir());
    end;
  end
  else if (CurUninstallStep = usDone) and HasParam('/ASK') then
  begin
    { Inno Setup's own final message is not shown with /SILENT. }
    if DeleteData then
      Text := 'Your data was deleted too. Your media files are untouched.'
    else
      Text := 'Your data is still in ' + DataDir() + '. A new installation continues where you left off.';
    TaskDialogMsgBox('StreamZH was removed', Text, mbInformation, MB_OK, [], 0);
  end;
end;
