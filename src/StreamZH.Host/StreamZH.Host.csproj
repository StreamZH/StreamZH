<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>StreamZH</AssemblyName>
    <RootNamespace>StreamZH.Host</RootNamespace>
    <!-- StreamZH runs on its own (Kestrel), never behind IIS: no web.config in the package. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../StreamZH.Core/StreamZH.Core.csproj" />
    <ProjectReference Include="../StreamZH.Data/StreamZH.Data.csproj" />
    <ProjectReference Include="../StreamZH.Parsing/StreamZH.Parsing.csproj" />
    <ProjectReference Include="../StreamZH.Metadata/StreamZH.Metadata.csproj" />
    <ProjectReference Include="../StreamZH.Indexers/StreamZH.Indexers.csproj" />
    <ProjectReference Include="../StreamZH.Usenet/StreamZH.Usenet.csproj" />
    <ProjectReference Include="../StreamZH.Library/StreamZH.Library.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Windows service: ServiceBase, IsWindowsService and the event log (only used on Windows). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <!-- Linux packages carry the installer: unpack, then sudo bash install-linux.sh. -->
    <None Include="../../tools/install-linux.sh" Link="install-linux.sh" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
